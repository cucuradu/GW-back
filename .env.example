# GrowWise Backend Environment Configuration Example
# Copy this file to .env and customize values for your local environment

# Security
SECRET_KEY=your-super-secret-django-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (Leave commented out to use default local SQLite db.sqlite3)
# PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/growwise
# MySQL:
# DATABASE_URL=mysql://root:password@localhost:3306/growwise

# Server Port (used by Docker / Render)
PORT=8000
